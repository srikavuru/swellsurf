    {
      "parameters": {
        "jsCode": "// DRY_RUN is on. Report exactly what would have happened and touch nothing.\n// Flip it off in the Safety node only once this output looks right.\nconst p = $json;\nreturn [{ json: {\n  dryRun: true,\n  wouldHave: [\n    `email \"${p.subject}\" to ${p.notifyEmail}`,\n    `post the confirmation to Telegram chat ${p.telegramChatId}`,\n  ],\n  body: p.body,\n  links: p.links,\n} }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
