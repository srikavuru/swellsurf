        "text": "={{ 'Locked in. Booking links are in your inbox - ' + $('Build booking links').first().json.spotName + ' ' + $('Build booking links').first().json.departDate + ' to ' + $('Build booking links').first().json.returnDate }}",
        "additionalFields": {
