    {
      "parameters": {
        "jsCode": "// Deep links into the real booking sites. No scraper, no per-run charge, and nothing\n// that silently breaks when someone reshuffles a page layout - you click and book.\nconst p      = $json;\nconst q      = encodeURIComponent;\nconst yymmdd = (iso) => iso.slice(2).replace(/-/g, '');\n\nconst links = {\n  googleFlights: `https://www.google.com/travel/flights?q=` +\n    q(`flights from ${p.origin} to ${p.destination} on ${p.departDate} through ${p.returnDate}`),\n  skyscanner: `https://www.skyscanner.net/transport/flights/` +\n    `${p.origin.toLowerCase()}/${p.destination.toLowerCase()}/` +\n    `${yymmdd(p.departDate)}/${yymmdd(p.returnDate)}/`,\n  stays: `https://www.airbnb.com/s/${q(p.stayNear)}/homes` +\n    `?checkin=${p.departDate}&checkout=${p.returnDate}&adults=${p.adults}`,\n};\n\nconst fares = (p.flights ?? []).length\n  ? p.flights.map((f, i) =>\n      `  ${i + 1}. ${f.currency} ${Math.round(f.price)} - ${f.airline}` +\n      ` (${f.stops ? `${f.stops} stop` : 'direct'})`).join('\\n')\n  : '  (no live fares were available when this fired)';\n\nconst subject = `${p.spotName} is firing - ${p.departDate} to ${p.returnDate}`;\n\nconst body = [\n  `${p.spotName}, up to ${p.peakSurf}, ${p.firingDays} days straight.`,\n  '',\n  p.forecastLines,\n  '',\n  `Fares seen at proposal time (${p.origin} to ${p.destination}):`,\n  fares,\n  '',\n  'Book it:',\n  `  Flights (Google)  ${links.googleFlights}`,\n  `  Flights (Skyscanner)  ${links.skyscanner}`,\n  `  Stays  ${links.stays}`,\n  '',\n  `Approved ${p.approvedAt ?? 'just now'}.`,\n].join('\\n');\n\nreturn [{ json: { ...p, links, subject, body } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        120
      ],
      "id": "3a1504dc-0b20-50d4-96b0-c0a361b36b07",
      "name": "Build booking links"
