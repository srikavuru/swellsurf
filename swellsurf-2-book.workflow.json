      "name": "note-1"
    },
    {
      "parameters": {
        "content": "## DRY_RUN is on by default\nEverything irreversible sits behind this one\nboolean in **Safety**. Run it a dozen times, read the output, and only then\nflip it to false.\n\nAdd your own side effects on the false branch - that is the only place in\neither workflow that is allowed to spend money or contact anyone.",
        "height": 320,
        "width": 480,
        "color": 3
      },
